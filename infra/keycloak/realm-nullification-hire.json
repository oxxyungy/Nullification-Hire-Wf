{
  "realm": "nullification-hire",
  "enabled": true,
  "displayName": "Nullification Hire",
  "roles": {
    "realm": [
      { "name": "HR_SPECIALIST", "description": "Creates and manages hire nullification requests" },
      { "name": "HR_MANAGER", "description": "Approves and manages hire nullification requests" },
      { "name": "ADMIN", "description": "Administrative access" }
    ]
  },
  "clients": [
    {
      "clientId": "nullification-hire-api",
      "name": "Nullification Hire API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "hr-specialist",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "hr-specialist", "temporary": false }],
      "realmRoles": ["HR_SPECIALIST"]
    },
    {
      "username": "hr-manager",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "hr-manager", "temporary": false }],
      "realmRoles": ["HR_MANAGER"]
    },
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin-user", "temporary": false }],
      "realmRoles": ["ADMIN"]
    }
  ]
}
